[common]
data_folder = ./data
result_folder = ./result
n_iter = 15
tol = 0.1
logfile = ./run.log
show_graph = no
random_seed = 8192

[snowflake]
# Required.
username =
# If externalbrowser auth fails, export SNOWFLAKE_PASSWORD in the environment
# for the username_password_mfa fallback.

[inference]
data_folder = ${common:data_folder}
result_folder = ${common:result_folder}
show_graph = ${common:show_graph}
logfile = ${common:logfile}
random_seed = ${common:random_seed}

# set the following for each run if needed
granularity_col = dummy
# Optional comma-separated staged granularities. When set, this overrides
# granularity_col; earlier stages are written under stage_<n>_<granularity>/,
# and the final stage is written to the top-level result folder.
# granularity_sequence = grade_substrand_id,skill_id
n_iter = 15
tol = 0.01
infer_mastery = yes
infer_item = yes
tune_discrimination = no
mastery_l2_penalty = 0.0
item_discrimination_l2_penalty = 0.0
# Additive linear trust-region step for item discrimination.
# When tune_discrimination = yes, a useful starting value is 0.2.
discrimination_step_size = 0.01
min_obs = 5
# Item freeze support thresholds can be a single value for all stages, or one
# value per granularity if granularity_sequence is enabled.
item_freeze_min_response_support = 10
item_freeze_min_student_support = 10
item_low_response_support_threshold = 10
item_low_student_support_threshold = 10
mastery_correct_rate_tolerance = 0.1
item_freeze_correct_rate_tolerance = 0.2
split_ratio = 0.2
student_sample_rate = 1.0

[difficulty_extension]
data_folder = ${common:data_folder}
result_folder = ${common:result_folder}
show_graph = ${common:show_graph}
logfile = ${common:logfile}

# set the following for each run if needed
regression_granularity = grade_strand_id
min_obs = 10
f_pvalue_threshod = 1.5



[knowledge_graph]
data_folder = ${common:data_folder}
result_folder = ${common:result_folder}
show_graph = ${common:show_graph}
logfile = ${common:logfile}

# set the following for each run if needed
min_obs = 30
use_enriched = no
test_frequency_cap = 10

[soft_prerequisite]
data_folder = ${common:data_folder}
result_folder = ${common:result_folder}
show_graph = ${common:show_graph}
logfile = ${common:logfile}

# set the following for each run if needed
n_grid = 11
grid_width = 2.0
n_sim = 500
n_run = 20
stability_threshold = 0.15

[sana_simulation]
data_folder = ${common:data_folder}
result_folder = simulation all settings 3
show_graph = ${common:show_graph}
logfile = ${common:logfile}

n_runs = 5
n_steps = 250
catalog_file = Content_report_Lantern_Graph.tsv
catalog_name = dummy_catalog
